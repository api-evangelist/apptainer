{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apptainer Container Runtime Images Instances API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Instances",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apptainer - List Instances",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apptainer.org/v1/instances"
          },
          "docs": "Returns a list of running Apptainer container instances"
        },
        {
          "info": {
            "name": "Apptainer - Start Instance",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.apptainer.org/v1/instances",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Starts a new container instance from an Apptainer image"
        }
      ]
    }
  ],
  "bundled": true
}